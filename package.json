{
  "name": "careerrank",
  "version": "0.1.0",
  "private": true,
  "description": "CareerRank monorepo",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @careerrank/web dev",
    "build": "pnpm --filter @careerrank/web build",
    "lint": "pnpm --filter @careerrank/web lint",
