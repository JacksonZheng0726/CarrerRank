# Runtime
APP_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:8000

# PostgreSQL
# Supply URL-safe generated credentials in .env. Do not commit .env.
POSTGRES_DB=careerrank
POSTGRES_USER=careerrank
POSTGRES_PASSWORD=e7be9005a7714ea46ea343a992fd3f3fd3cca893f77ffd68f1cdf82c43189c60
DATABASE_URL=postgresql+psycopg://careerrank:a7f4c9d2b1e6f0a8d9c3b2e1f4a7d8c1b4e6f9a2c7d0b3e4f5a6b7c8d9e0f1@127.0.0.1:5432/careerrank
TEST_DATABASE_URL=postgresql+psycopg://careerrank:a7f4c9d2b1e6f0a8d9c3b2e1f4a7d8c1b4e6f9a2c7d0b3e4f5a6b7c8d9e0f1@127.0.0.1:5433/careerrank_test
# Keep this true for the documented full backend suite so missing services fail closed.
REQUIRE_INTEGRATION_TESTS=true
# DATABASE_URL shape:
# postgresql+psycopg://careerrank:<url-safe-password>@127.0.0.1:5432/careerrank
# TEST_DATABASE_URL shape (isolated Compose test database):
# postgresql+psycopg://careerrank:<url-safe-password>@127.0.0.1:5433/careerrank_test

# Redis
REDIS_URL=redis://localhost:6379/0

# Authentication
# Generate JWT_SECRET with: openssl rand -hex 32
JWT_SECRET=a7f4c9d2b1e6f0a8d9c3b2e1f4a7d8c1b4e6f9a2c7d0b3e4f5a6b7c8d9e0f1
JWT_ISSUER=careerrank-api
JWT_AUDIENCE=careerrank-web
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=14
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# JSON-encoded list of browser origins allowed to send credentialed requests.
CORS_ORIGINS=["http://localhost:3000"]
